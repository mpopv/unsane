{
  "name": "unsane",
  "version": "0.1.0",
  "description": "A tiny, zero-dependency, run-anywhere HTML sanitization library written in TypeScript.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npm run clean && tsc --project tsconfig.json",
    "typecheck": "npm run build && npm run typecheck:built",
    "typecheck:built": "tsc --project tsconfig.test.json",
    "test": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:browser": "npm run build && npm run test:browser:built",
    "test:browser:built": "playwright test",
    "test:fuzz": "npm run build && npm run test:fuzz:built",
    "test:fuzz:built": "jazzer fuzz/sanitizer.fuzz.mjs --sync --mode=regression --timeout=2000 -i dist/ fuzz/corpus",
    "fuzz": "npm run build && jazzer fuzz/sanitizer.fuzz.mjs --sync --timeout=2000 -i dist/ fuzz/corpus -- -max_len=65536 -timeout=2 -rss_limit_mb=2048 -artifact_prefix=fuzz/artifacts/",
    "test:update-html5lib": "node scripts/update-html5lib-corpus.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "npm run build",
    "version": "tsx scripts/prepare-release.ts",
    "clean": "rm -rf dist",
    "analyze-size": "npm run build && npm run analyze-size:built",
    "analyze-size:built": "tsx measure-size.ts",
    "benchmark": "npm run build && npm run benchmark:built",
    "benchmark:built": "node benchmarks/sanitize.mjs --check",
    "benchmark:json": "npm run build && node benchmarks/sanitize.mjs --json",
    "smoke:package": "npm run build && npm run smoke:package:built",
    "smoke:package:built": "node scripts/package-smoke-test.mjs",
    "release:notes": "tsx scripts/release-notes.ts",
    "verify:release": "node scripts/post-release-verify.mjs",
    "release": "bin/release.sh"
  },
  "keywords": [
    "html",
    "sanitization",
    "security",
    "typescript"
  ],
  "author": "mpopv <mattpopovich@outlook.com> (https://github.com/mpopv)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mpopv/unsane.git"
  },
  "bugs": {
    "url": "https://github.com/mpopv/unsane/issues"
  },
  "homepage": "https://github.com/mpopv/unsane#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@jazzer.js/core": "^4.0.0",
    "@playwright/test": "^1.61.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitest/coverage-v8": "^4.1.11",
    "dompurify": "^3.4.12",
    "esbuild": "^0.28.1",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "fast-check": "^4.9.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.3",
    "sanitize-html": "^2.17.6",
    "tsx": "^4.22.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "qs": "^6.15.3"
  },
  "bin": {
    "unsane": "bin/unsane.js"
  }
}
