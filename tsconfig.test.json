{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "rootDir": "."
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "measure-size.ts",
    "playwright.config.ts",
    "scripts/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["coverage", "dist", "node_modules"]
}
